## VERSIONS (from Helm repos)
# helm search repo confluentinc
export CFK_CHART_VERSION=0.1514.19
export CFK_INIT_CONTAINER_VERSION=3.2.1
export CMF_VERSION=2.3.0
export FKO_VERSION=1.140.1

# https://hub.docker.com/r/confluentinc/cp-server/t
export CONFLUENT_PLATFORM_VERSION=8.2.0
export CONFLUENT_PLATFORM_SR_VERSION=7.9.6

# https://hub.docker.com/r/confluentinc/cp-enterprise-control-center-next-gen/tags
export CONTROL_CENTER_VERSION=2.4.2

# https://hub.docker.com/r/confluentinc/cp-flink/tags
export CP_FLINK_TAG=2.1.1-cp2-java21

# https://github.com/apache/flink-kubernetes-operator/blob/main/docs/content/docs/custom-resource/reference.md
# For now, use the one matching CP_FLINK_SQL_TAG (since this is used for the FlinkEnvironment/FlinkApplication)
export CP_FLINK_MAJOR_VERSION=v2_1
# export CP_FLINK_MAJOR_VERSION=v1_19

# https://hub.docker.com/r/confluentinc/cp-flink-sql/tags
export CP_FLINK_SQL_TAG=1.19-cp7

# https://gateway.envoyproxy.io/docs/install/install-helm/
export ENVOY_GATEWAY_VERSION=v1.7.2

# https://github.com/hashicorp/vault-helm/releases
export VAULT_CHART_VERSION=0.32.0

## Configs
# Use confluent-demo namespace to not interfere with things in confluent namespace
export NAMESPACE=confluent-demo
export ENVOY_GATEWAY_NAMESPACE=envoy-gateway
export OPERATOR_NAMESPACE=confluent-demo
export KEYCLOAK_NAMESPACE=keycloak
export VAULT_NAMESPACE=vault

export FLINK_ENVIRONMENT_NAME=demo

export CMF_SERVICE_ACCOUNT=cmf-confluent-demo

export LOCAL_DIR=./local
export CERT_DIR=./local/certs
export CFSSL_DIR=./local/cfssl

# Defaults to 127-0-0-1.nip.io; can be set using `./scripts/utils/set_base_domain.sh <IP>`
export BASE_DOMAIN=127-0-0-1.nip.io
export BASE_INT_DOMAIN=int.127-0-0-1.nip.io
export BASE_EXT_DOMAIN=ext.127-0-0-1.nip.io

export ORDER_VERSION=latest
export RECIPE_v1_VERSION=latest
export RECIPE_v2_VERSION=latest

export FLINK_DEV_ENV_NAME=development
export FLINK_DEV_NAMESPACE=confluent-demo-development
export FLINK_DEV_APP_NAME=my-app

export FLINK_PROD_ENV_NAME=production
export FLINK_PROD_NAMESPACE=confluent-demo-production
export FLINK_PROD_APP1_NAME=my-app-one
export FLINK_PROD_APP2_NAME=my-app-two

export CLIENT_ID=kafka
export CLIENT_SECRET=LpXqoU8bqCqXgNsPKAJIJhQ9WafgWwsj
